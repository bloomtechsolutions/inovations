{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p public/shared && cp shared/logic.js public/shared/logic.js",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:route", "destination": "/api/index?route=:route" }
  ],
  "functions": {
    "api/index.js": { "includeFiles": "{config,samples}.json", "maxDuration": 10 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
